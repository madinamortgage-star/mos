generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  nmls          String?
  role          String    @default("lo") // lo | admin | processor
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  loans         Loan[]
  callLogs      CallLog[]
  notes         Note[]
  partners      Partner[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id          String    @id @default(cuid())
  externalId  String?   @unique // e.g. "C-1001" from legacy data
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  title       String?
  city        String?
  website     String?
  linkedin    String?
  source      String?   // Referral | Web Form | Cold Outreach | Event | LinkedIn | etc.
  type        String?   // Lead | Partner | Investor | Client | Candidate
  status      String    @default("Active") // Active | Hot | Warm | Cold | Nurture | On Hold | Closed | Lost
  lifecycle   String?   // Subscriber | Lead | MQL | SQL | Opportunity | Customer | Evangelist
  priority    String?   // Critical | High | Medium | Low
  ownerId     String?
  tags        String[]  @default([])
  notes       String?
  dob         String?   // date of birth (display string)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pipelines       ContactPipeline[]
  loans           Loan[]
  messages        Message[]
  activityLogs    ActivityLog[]
  callLogs        CallLog[]
}

model ContactPipeline {
  id          String   @id @default(cuid())
  contactId   String
  pipeline    String   // sales | recruit | investor | onboard | partner | vendor
  stage       String?
  dealValue   Float?
  probability Int?
  lastContact String?
  nextFollow  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, pipeline])
}

// ─── Loans (Pipeline) ────────────────────────────────────────────────────────

model Loan {
  id          String   @id @default(cuid())
  externalId  String?  @unique // e.g. "L001"
  contactId   String
  ownerId     String?  // loan officer

  // Borrower snapshot (denormalized for performance)
  firstName   String
  lastName    String

  // Loan details
  amount      Float?
  rate        String?
  product     String?  // 30-yr Conventional | FHA | VA | Jumbo | etc.
  downPayment String?
  ltv         String?
  dti         String?
  closingDate String?

  // Pipeline status
  stage       String   @default("lead") // lead | app | pre | proc | uw | fund
  status      String   @default("warm") // hot | warm | cool | stall | ok
  statusLabel String?

  // Team
  processor   String?
  lender      String?

  // Financials
  revenue     Float?
  commission  Float?

  notes       String?
  date        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact     Contact  @relation(fields: [contactId], references: [id])
  owner       User?    @relation(fields: [ownerId], references: [id])
  messages    Message[]
  activityLogs ActivityLog[]
}

// ─── Prospecting / Call Queue ─────────────────────────────────────────────────

model ProspectCard {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  name        String
  company     String?
  phone       String?
  tag         String?  // lead | agent | pastclient | partner
  tagLabel    String?
  context     String?
  action      String?
  priority    String   @default("med") // high | med | low
  bucket      String   @default("today") // overdue | hot | today
  overdueBy   String?
  daysSince   Int      @default(0)
  section     String   @default("suggest") // must | high | suggest

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  callLogs    CallLog[]
}

model CallLog {
  id            String    @id @default(cuid())
  prospectCardId String?
  contactId     String?
  userId        String?
  disposition   String    // Connected | Left voicemail | No pickup | Wrong number
  notes         String?
  duration      Int?      // seconds
  calledAt      DateTime  @default(now())

  prospectCard  ProspectCard? @relation(fields: [prospectCardId], references: [id])
  contact       Contact?      @relation(fields: [contactId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
}

// ─── Partners ────────────────────────────────────────────────────────────────

model Partner {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  name          String   // company / brokerage name
  contact       String?  // primary contact person
  phone         String?
  email         String?
  birthday      String?
  website       String?
  category      String?  // realtor | cpa | financial-advisor | title | etc.
  group         String   @default("act") // vip | act | new | cold
  status        String   @default("warm") // hot | warm | cold
  deals12       Int      @default(0)
  totalTx       Int      @default(0)
  annualValue   Float    @default(0)
  lastContact   String?
  nextContact   String?
  notes         String?
  callDone      Boolean  @default(false)
  daysSinceContact Int   @default(0)
  dayBucket     String?
  ownerId       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User?    @relation(fields: [ownerId], references: [id])
  activityLogs  ActivityLog[]
}

// ─── Messaging & Notes ───────────────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  contactId String?
  loanId    String?
  kind      String   @default("sms") // sms | email | note
  direction String   @default("outbound") // inbound | outbound
  body      String
  sentAt    DateTime @default(now())

  contact   Contact? @relation(fields: [contactId], references: [id])
  loan      Loan?    @relation(fields: [loanId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  contactId String?
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User?    @relation(fields: [authorId], references: [id])
}

// ─── Activity Log ────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  contactId   String?
  loanId      String?
  partnerId   String?
  kind        String   // call | email | sms | note | stage_change | system
  title       String
  subtitle    String?
  occurredAt  DateTime @default(now())

  contact     Contact? @relation(fields: [contactId], references: [id])
  loan        Loan?    @relation(fields: [loanId], references: [id])
  partner     Partner? @relation(fields: [partnerId], references: [id])
}
