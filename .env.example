# =============================================================================
# MOS — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and paste your real values there.
# `.env.local` is gitignored — never commit secrets.
#
# TODO(Vercel environment variables): add the SAME variables in
#   Vercel → Project Settings → Environment Variables
# for both the Preview and Production environments. Preview deploys also work
# with these left blank — they just run in placeholder mode.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL
#   The unique URL of your Supabase project, e.g. https://xxxxx.supabase.co
#   Safe to expose to the browser.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   The "anon / public" API key. Used by the browser and respects RLS.
#   Safe to expose to the browser.
#
# SUPABASE_SERVICE_ROLE_KEY
#   The "service_role" key. BYPASSES RLS — server-side only.
#   NEVER expose to the browser. NEVER commit. Used in admin / cron tasks.
#
# Until the first two are set, the app stays in "placeholder mode":
#   - Supabase clients return null / a stub
#   - auth Server Actions return a friendly "not configured" message
#   - protected routes render with a stub user
# Fill them in and auth + data activate automatically — no code changes.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
#   Public site URL — used for auth email/OAuth callbacks (`/auth/callback`).
#   Local: http://localhost:3000
#   Vercel: set to your production domain (and rely on Vercel's per-deploy URL
#           for previews, or set it per environment).
#
# TODO(Supabase redirect URLs): whatever you set here, also add
#   <NEXT_PUBLIC_SITE_URL>/auth/callback
# under Supabase → Authentication → URL Configuration → Redirect URLs
# (add one entry per environment: localhost, Vercel preview, production).
#
# TODO(Google OAuth): when you enable Google sign-in, also register the same
# callback URL on the Google OAuth consent screen and enable the Google
# provider in Supabase → Authentication → Providers.
#
# TODO(production RLS hardening): before launch, review the
# `TODO(prod RLS hardening)` block in
# supabase/migrations/20260101000100_rls_tenancy.sql and run `supabase db lint`.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
