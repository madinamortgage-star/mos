# =============================================================================
# MOS — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and paste your real values there.
# `.env.local` is gitignored — never commit secrets.
#
# On Vercel: add these in Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
#
# NEXT_PUBLIC_SUPABASE_URL
#   The unique URL of your Supabase project, e.g. https://xxxxx.supabase.co
#   Safe to expose to the browser.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   The "anon / public" API key. Used by the browser and respects RLS.
#   Safe to expose to the browser.
#
# SUPABASE_SERVICE_ROLE_KEY
#   The "service_role" key. BYPASSES RLS — server-side only.
#   NEVER expose to the browser. NEVER commit. Used in admin / cron tasks.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public site URL used for auth callbacks, emails, OG tags.
# Local: http://localhost:3000
# Vercel: set to your production domain.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
